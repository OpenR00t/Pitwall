{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pitwall",
  "version": "0.1.0",
  "identifier": "app.pitwall.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pitwall",
        "width": 1500,
        "height": 940,
        "minWidth": 1100,
        "minHeight": 700,
        "backgroundColor": "#1d2021"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../backend/pitwall_backend/": "backend/pitwall_backend/",
      "../backend/requirements.txt": "backend/requirements.txt"
    }
  }
}
